{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": { "includes": ["**", "!**/.m1-artifacts/**", "!apps/worker/test/fixtures/artwork/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["apps/*/test/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    }
  ]
}
