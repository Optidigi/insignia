{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "test/**/*.ts", "test/**/*.mts", "fixtures/**/*.mts"],
  "exclude": []
}
