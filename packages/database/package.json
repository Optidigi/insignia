{
  "name": "@insignia/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@insignia/application": "workspace:*",
    "@insignia/cart-authorization": "workspace:*",
    "@insignia/contracts": "workspace:*",
    "@insignia/domain": "workspace:*",
    "@insignia/visualizer": "workspace:*",
    "kysely": "0.29.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "@insignia/shopify": "workspace:*"
  }
}
