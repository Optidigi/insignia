{
  "name": "@insignia/storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/copy-theme-asset.mts",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.mts",
    "typecheck:test": "tsc -p tsconfig.test.json && tsc -p tsconfig.test-browser.json"
  },
  "dependencies": {
    "@insignia/contracts": "workspace:*",
    "@insignia/ui-localization": "workspace:*",
    "@insignia/visualizer": "workspace:*",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "liquidjs": "10.30.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
