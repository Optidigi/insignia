---
import '../styles/admin-editor.css';
import AdminNavigation from '../components/AdminNavigation.astro';
import AdminPageSkeleton from '../components/AdminPageSkeleton';

interface Props {
  title: string;
  apiKey?: string;
  ready?: boolean;
}
const { title, apiKey, ready = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-admin-ready={ready ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    {apiKey && <meta name="shopify-api-key" content={apiKey} />}
    <title>{title} · Insignia</title>
    {apiKey && <script is:inline src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>}
    <script is:inline defer src="https://cdn.shopify.com/shopifycloud/polaris-1.1.js"></script>
  </head>
  <body>
    {apiKey && <AdminNavigation />}
    {!ready && <div id="admin-route-skeleton">
      <AdminPageSkeleton pathname={Astro.url.pathname} />
    </div>}
    {!ready && <div id="admin-route-failure" hidden>
      <s-banner tone="critical" heading="Interface unavailable">Reopen Insignia from Shopify Admin to try again.</s-banner>
    </div>}
    <div id="admin-route-content" inert={!ready}><slot /></div>
    <script>
      import { installAdminNavigation } from '../shared/admin-navigation';
      if (document.documentElement.dataset.adminReady !== 'true') installAdminNavigation();
    </script>
  </body>
</html>
