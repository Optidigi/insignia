---
import StorefrontSetup from '../../../../../../frontend/admin/src/islands/StorefrontSetup';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminFrameAncestors } from '../../../server/admin/frame-ancestors';

const apiKey = process.env.SHOPIFY_CLIENT_ID;
const csp =
  `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-7Kx2FI/YDPBd7xu2wdR0JpTXl3VRA74S2DMe071cLSA=' 'sha256-UIrFqcaitjA3OKa9mHKajg3N+0Y7tW9+y0o3QmMFeZQ='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ https://cdn.shopify.com/shopifycloud/admin-ui-foundations/experimental/; ${adminFrameAncestors(Astro.url)}; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey)) return Astro.rewrite('/admin/unavailable');
---
<AdminLayout titleKey="admin-shell:titles.storefront" apiKey={apiKey}>
<StorefrontSetup locale={Astro.url.searchParams.get('locale')} client:polaris />
</AdminLayout>
