---
// Methods has one real destination; keep bounded Shopify host hints, never bearer/session query material.
const query = new URLSearchParams();
const rules = {
  host: /^[A-Za-z0-9+/_=-]{1,1024}$/,
  shop: /^[a-z0-9][a-z0-9-]{0,62}\.myshopify\.com$/,
  embedded: /^1$/,
  locale: /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/,
};
for (const [name, rule] of Object.entries(rules)) {
  const values = Astro.url.searchParams.getAll(name);
  if (values.length === 1 && values[0] && values[0].length <= (name === 'host' ? 1024 : 128) && rule.test(values[0])) query.set(name, values[0]);
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Location', '/admin/methods' + (query.size ? `?${query}` : ''));
return new Response(null, {status:302, headers:Astro.response.headers});
---
