---
import MethodLibrary from '../../../islands/MethodLibrary';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const apiKey = process.env.SHOPIFY_CLIENT_ID;
const csp =
  "default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/; frame-ancestors https://admin.shopify.com https://*.myshopify.com; base-uri 'none'; form-action 'self'";
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey))
  return Astro.rewrite('/admin/unavailable');
---
<AdminLayout title="Decoration method library" apiKey={apiKey}>
<MethodLibrary client:load />
</AdminLayout>
