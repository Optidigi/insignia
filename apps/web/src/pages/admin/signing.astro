---
import SigningOperator from '../../../../../frontend/admin/src/islands/SigningOperator';
import AdminLayout from '../../layouts/AdminLayout.astro';

import { adminServices } from '../../server/admin/runtime';
import { adminFrameAncestors } from '../../server/admin/frame-ancestors';

let available = false;
try {
  available = Boolean(adminServices()?.signingOwner);
} catch {
  /* Invalid capability stays unavailable. */
}
const apiKey = process.env.SHOPIFY_CLIENT_ID;
const csp =
  `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-7Kx2FI/YDPBd7xu2wdR0JpTXl3VRA74S2DMe071cLSA=' 'sha256-xKBggZ2csD5Lp4tQr9izOLUTCZc1Nf4gged/rUHQ2+Y='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ https://cdn.shopify.com/shopifycloud/admin-ui-foundations/experimental/; ${adminFrameAncestors(Astro.url)}; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
// Operator-only page: where this deployment has no signing owner it does not exist for merchants or reviewers.
if (!available) return new Response(null, { status: 404, headers: { 'Cache-Control': 'private, no-store' } });
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey)) return Astro.rewrite('/admin/unavailable');
---
<AdminLayout title="Signing setup" apiKey={apiKey}>
<SigningOperator client:polaris />
</AdminLayout>
