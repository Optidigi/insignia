---
import SigningOperator from '../../../../../frontend/admin/src/islands/SigningOperator';
import AdminLayout from '../../layouts/AdminLayout.astro';

import { adminServices } from '../../server/admin/runtime';

let available = false;
try { available = Boolean(adminServices()?.signingOwner); } catch { /* Invalid capability stays unavailable. */ }
const apiKey = process.env.SHOPIFY_CLIENT_ID;
const csp =
  "default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-UAsB0KRBWzyM3993V+dfqSKU2EkVmZChnGDvWJyraz8=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ https://cdn.shopify.com/shopifycloud/admin-ui-foundations/experimental/; frame-ancestors https://admin.shopify.com https://*.myshopify.com; base-uri 'none'; form-action 'self'";
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!available || !apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey))
  return Astro.rewrite('/admin/unavailable');
---
<AdminLayout title="Signing setup" apiKey={apiKey}>
<SigningOperator client:polaris />
</AdminLayout>
