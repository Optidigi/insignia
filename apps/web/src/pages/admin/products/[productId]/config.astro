---
import MerchantConfigEditor from '../../../../islands/MerchantConfigEditor';
import AdminLayout from '../../../../layouts/AdminLayout.astro';

const productId = Astro.params.productId ?? '';
if (!/^[1-9][0-9]*$/.test(productId)) return Astro.redirect('/admin/products');
const apiKey = process.env.SHOPIFY_CLIENT_ID;
let storageOrigin = '';
try {
  const endpoint = new URL(process.env.ARTWORK_R2_ENDPOINT ?? '');
  if (
    endpoint.protocol === 'https:' &&
    !endpoint.username &&
    !endpoint.password &&
    !endpoint.search &&
    !endpoint.hash &&
    endpoint.pathname === '/'
  )
    storageOrigin = endpoint.origin;
} catch {}
const csp =
  `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ ${storageOrigin}; frame-ancestors https://admin.shopify.com https://*.myshopify.com; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey))
  return new Response('Admin configuration unavailable', { status: 503, headers: Astro.response.headers });
---
<AdminLayout title="Product configuration" apiKey={apiKey}>
{process.env.INSIGNIA_M5_002_DIAGNOSTIC === '1' && <s-banner tone="info">Development preview: draft saves are local. Publication is disabled.</s-banner>}
    <MerchantConfigEditor mode="config" productId={productId} client:load />
</AdminLayout>
