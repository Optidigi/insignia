---
import OrdersOverview from '../../../../../../frontend/admin/src/islands/OrdersOverview';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminFrameAncestors } from '../../../server/admin/frame-ancestors';

import { monthlyBillingEnabled } from '../../../server/admin/monthly-billing';

const apiKey = process.env.SHOPIFY_CLIENT_ID;
let storageOrigin = '';
try {
  const endpoint = new URL(process.env.ARTWORK_R2_ENDPOINT ?? '');
  if (
    endpoint.protocol === 'https:' &&
    !endpoint.username &&
    !endpoint.password &&
    !endpoint.search &&
    !endpoint.hash &&
    endpoint.pathname === '/'
  )
    storageOrigin = endpoint.origin;
} catch {}
const csp = `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-7Kx2FI/YDPBd7xu2wdR0JpTXl3VRA74S2DMe071cLSA=' 'sha256-xKBggZ2csD5Lp4tQr9izOLUTCZc1Nf4gged/rUHQ2+Y='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ https://cdn.shopify.com/shopifycloud/admin-ui-foundations/experimental/ ${storageOrigin}; ${adminFrameAncestors(Astro.url)}; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey)) return Astro.rewrite('/admin/unavailable');
---
<AdminLayout titleKey="admin-shell:titles.orders" apiKey={apiKey}>
<OrdersOverview monthlyBilling={monthlyBillingEnabled()} locale={Astro.url.searchParams.get('locale')} client:polaris />
</AdminLayout>
