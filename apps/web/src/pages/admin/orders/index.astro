---
import PurchaseArtwork from '../../../islands/PurchaseArtwork';
import '../../../styles/admin-editor.css';

const apiKey = process.env.SHOPIFY_CLIENT_ID;
let storageOrigin = '';
try {
  const endpoint = new URL(process.env.ARTWORK_R2_ENDPOINT ?? '');
  if (endpoint.protocol === 'https:' && !endpoint.username && !endpoint.password && !endpoint.search && !endpoint.hash && endpoint.pathname === '/') storageOrigin = endpoint.origin;
} catch {}
const csp =
  `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data:; connect-src 'self' ${storageOrigin}; frame-ancestors https://admin.shopify.com https://*.myshopify.com; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey))
  return new Response('Admin configuration unavailable', { status: 503, headers: Astro.response.headers });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="shopify-api-key" content={apiKey} />
    <title>Orders and artwork · Insignia</title>
    <script is:inline src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
    <script is:inline src="https://cdn.shopify.com/shopifycloud/polaris-1.1.js"></script>
  </head>
  <body>
    <PurchaseArtwork client:load />
  </body>
</html>
