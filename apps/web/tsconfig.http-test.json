{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@shopify/polaris-types"]
  },
  "include": ["test/*.mts", "test/artwork/**/*.mts", "test/artwork/**/*.tsx"]
}
