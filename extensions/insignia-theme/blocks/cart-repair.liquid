<insignia-cart-repair proxy-base="{{ routes.root_url }}apps/{{ block.settings.proxy_prefix | escape }}" cart-root="{{ routes.root_url }}" country="{{ localization.country.iso_code }}" market-id="{{ localization.market.id }}"></insignia-cart-repair>
{% render 'customise-control', product: product, block: block, control: 'automatic' %}
{% schema %}
{
  "name": "Insignia storefront",
  "target": "body",
  "javascript": "insignia-storefront.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Enable once, then save your theme. Published Insignia products automatically use Customise in place of purchase buttons. Ordinary products keep their theme controls."
    },
    {
      "type": "checkbox",
      "id": "auto_placement",
      "label": "Place Customise automatically",
      "default": true,
      "info": "Turn off only when using the Insignia customization app block for placement."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use the storefront language."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Match theme purchase button"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_width",
      "label": "Button width",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Match theme"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "content",
          "label": "Fit text"
        }
      ]
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Text color override"
    },
    {
      "type": "checkbox",
      "id": "override_radius",
      "label": "Override corner radius",
      "default": false
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "override_border",
      "label": "Override border width",
      "default": false
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color override"
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "proxy_prefix",
      "label": "App proxy prefix",
      "default": "insignia"
    }
  ]
}
{% endschema %}
