    "effective": {
      "query": "\n      SELECT c.config_id, c.effective_revision_id AS revision_id,\n        c.effective_operation_id AS operation_id\n      FROM product_configs c\n      JOIN shops s ON s.shop_id = c.shop_id\n      JOIN installation_generations i ON i.shop_id = s.shop_id AND i.generation = s.current_generation\n      JOIN publication_operations p ON p.shop_id = c.shop_id AND p.config_id = c.config_id\n        AND p.operation_id = c.effective_operation_id\n      WHERE c.shop_id = $1 AND c.external_product_id = $2\n        AND i.deactivated_at IS NULL AND p.installation_generation = s.current_generation\n        AND p.status = 'activated' AND p.revision_id = c.effective_revision_id\n        AND p.operation_sequence = c.publication_sequence\n        AND p.observed_projection = p.expected_projection\n        AND p.observed_projection_digest = p.expected_projection_digest",
      "parameterRoles": [
        "synthetic tenant/config/product"
      ],
      "plan": {
        "Plan": {
          "Node Type": "Nested Loop",
          "Parallel Aware": false,
          "Async Capable": false,
          "Join Type": "Inner",
          "Startup Cost": 0.7,
          "Total Cost": 22.46,
