# Template: enable only with reviewed immutable paths and exact allocated identities.
[Unit]
Description=Insignia writer exclusion and encrypted daily snapshot
[Service]
Type=oneshot
# The approved host inspector is owned by this existing UID1000 user manager.
User=serveradmin
Group=serveradmin
UMask=0077
EnvironmentFile=/etc/insignia/backup.env
Environment=XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/opt/insignia/runtime/bin/node /opt/insignia/runtime/scripts/operations/backup-run.mts /etc/insignia/backup-run.json
RuntimeDirectory=insignia-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=75min
TimeoutStopSec=150s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/insignia-backup /var/lib/insignia-backup-runs /var/lib/insignia-backup-replica-runs /run/insignia-backup
# Host maintenance needs the Docker socket and its own inspector user bus. Never mount either into the app.
# Exact IDs/config/image allowlist and scoped start/stop are enforced by backup-run.mts.
