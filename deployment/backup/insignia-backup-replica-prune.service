[Unit]
Description=Prune owned expired Insignia encrypted off-host snapshots
[Service]
Type=oneshot
User=serveradmin
Group=serveradmin
UMask=0077
ExecStart=/opt/insignia/runtime/bin/node /opt/insignia/runtime/scripts/operations/backup-replica.mjs prune /etc/insignia/backup-replica.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/insignia-backup-replica-runs
