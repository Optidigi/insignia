[Unit]
Description=Prune owned expired Insignia encrypted off-host snapshots
[Service]
Type=oneshot
User=insignia-backup
Group=insignia-backup
UMask=0077
ExecStart=/opt/insignia/runtime/bin/node /opt/insignia/scripts/operations/backup-replica.mjs prune /etc/insignia/backup-replica.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/insignia-backup-replica-runs
