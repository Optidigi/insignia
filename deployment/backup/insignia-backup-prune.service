[Unit]
Description=Prune Insignia expired encrypted snapshots
[Service]
Type=oneshot
User=serveradmin
Group=serveradmin
UMask=0077
ExecStart=/opt/insignia/runtime/bin/node /opt/insignia/runtime/scripts/operations/backup.mts prune --store /var/lib/insignia-backup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/insignia-backup
