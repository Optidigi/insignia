# Build context contains only the CI-produced operations-package directory.
FROM node:24.21.0-bookworm-slim@sha256:51b1100cc2a83d370c6a60952e3f2989c8a43159d0e38586e090f3b3326efefd
WORKDIR /srv/insignia
COPY --chown=1000:1000 operations-package/ ./
USER 1000:1000
ENTRYPOINT ["/srv/insignia/bin/node", "/srv/insignia/scripts/operations/heartbeat.mts", "--loop"]
