/** Structural review of the Shopify-owned handoff. Never shipped by the application. */
const draftPlans = [
  { name: 'Free', price: 'Free', detail: 'No recurring subscription fee' },
  { name: 'Paid plan 1', price: 'Price to be decided', detail: 'Billing terms to be decided' },
  { name: 'Paid plan 2', price: 'Price to be decided', detail: 'Billing terms to be decided' },
] as const;

export function settingsPlanPreview(): string {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Select a plan · local Shopify handoff preview</title><script defer src="/__preview/assets.js"></script><script defer src="/__preview/polaris.js"></script><style>
body{margin:0}.plan-preview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.plan-preview-card{min-inline-size:0}.plan-preview-price{font:inherit;font-weight:650;font-size:24px;line-height:1.3;margin:0;min-block-size:64px}.plan-preview-meta{min-block-size:40px}.plan-preview-note{max-inline-size:70ch}@media(max-width:760px){.plan-preview-grid{grid-template-columns:1fr}.plan-preview-price,.plan-preview-meta{min-block-size:0}}
</style></head><body><s-page heading="Select a plan" inlineSize="base"><s-link slot="breadcrumb-actions" href="/admin/settings/billing">Billing</s-link><s-stack gap="large"><s-banner heading="Local layout preview" tone="info"><s-paragraph>Shopify hosts plan selection and approval. These three draft plans show the intended structure. Paid prices and all plan inclusions are undecided, so selection is disabled here.</s-paragraph></s-banner><div class="plan-preview-grid">${draftPlans.map((plan) => `<div class="plan-preview-card"><s-section accessibilityLabel="${plan.name}"><s-stack gap="base"><s-heading>${plan.name}</s-heading><p class="plan-preview-price">${plan.price}</p><div class="plan-preview-meta"><s-text color="subdued">${plan.detail}</s-text></div><s-button disabled variant="primary" inlineSize="fill">Select ${plan.name}</s-button><s-divider></s-divider><s-paragraph color="subdued">Included features to be decided</s-paragraph></s-stack></s-section></div>`).join('')}</div><div class="plan-preview-note"><s-paragraph color="subdued">This page does not create a subscription, change access or define a new pricing policy. The connected app opens Shopify’s configured plan page.</s-paragraph></div><s-stack direction="inline" gap="base"><s-link href="https://shopify.dev/docs/apps/launch/billing/shopify-app-pricing#plan-selection-page" target="_blank">Shopify plan selection reference</s-link></s-stack></s-stack></s-page></body></html>`;
}
