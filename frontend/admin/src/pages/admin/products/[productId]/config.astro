---
import '../../../../../examples/admin/support/placement-workflow-preview.css';
import '../../../../../examples/admin/support/placement-variant-photo-panel.css';
import '../../../../../examples/admin/support/placement-method-manager.css';
import '../../../../../examples/admin/support/placement-image-picker.css';
import '../../../../../examples/admin/support/placement-setup-copy-dialog.css';
import '../../../../../examples/admin/support/placement-setup-copy-review.css';
import SelectedProductContainer from '../../../../islands/SelectedProductContainer';
import AdminLayout from '../../../../layouts/AdminLayout.astro';

const productId = Astro.params.productId ?? '';
if (!/^[1-9][0-9]*$/.test(productId)) return Astro.redirect('/admin/products');
const apiKey = process.env.SHOPIFY_CLIENT_ID;
let storageOrigin = '';
try {
  const endpoint = new URL(process.env.ARTWORK_R2_ENDPOINT ?? '');
  if (
    endpoint.protocol === 'https:' &&
    !endpoint.username &&
    !endpoint.password &&
    !endpoint.search &&
    !endpoint.hash &&
    endpoint.pathname === '/'
  )
    storageOrigin = endpoint.origin;
} catch {}
const csp =
  `default-src 'none'; script-src 'self' https://cdn.shopify.com 'sha256-UAsB0KRBWzyM3993V+dfqSKU2EkVmZChnGDvWJyraz8=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U='; style-src 'self' 'unsafe-inline' https://cdn.shopify.com; font-src https://cdn.shopify.com; img-src 'self' https: data: blob:; connect-src 'self' https://cdn.shopify.com/shopifycloud/admin-ui-foundations/icons/ https://cdn.shopify.com/shopifycloud/admin-ui-foundations/experimental/ ${storageOrigin}; frame-ancestors https://admin.shopify.com https://*.myshopify.com; base-uri 'none'; form-action 'self'`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!apiKey || !/^[A-Za-z0-9_-]{1,128}$/.test(apiKey))
  return Astro.rewrite('/admin/unavailable');
---
<AdminLayout titleKey="admin-shell:titles.configuration" apiKey={apiKey}>
    <SelectedProductContainer productId={`gid://shopify/Product/${productId}`} locale={Astro.url.searchParams.get('locale')} client:polaris />
</AdminLayout>
