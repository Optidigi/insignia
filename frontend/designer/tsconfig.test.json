{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts/**/*.mts",
    "scripts/fixtures/*.tsx",
    "vite.library.config.ts"
  ]
}
